{
  "name": "deep-fryer",
  "version": "0.3.0",
  "description": "A local desktop image editor.",
  "private": true,
  "main": "out/main/index.js",
  "author": "Deep Fryer",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "assets:render": "node scripts/render-help-media.mjs",
    "assets:capture": "node scripts/capture-help-editor.mjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "vue": "3.5.44",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "gifenc": "1.0.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "^3.1.5"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "build": {
    "appId": "com.deepfryer.desktop",
    "productName": "Deep Fryer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
